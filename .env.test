# Test-time environment. Committed (no real secrets).
# Used by tests/conftest.py and CI. Override per-test via monkeypatch where needed.

ENV=test
DEBUG=false
APP_NAME=pharmacy-api-test
API_V1_PREFIX=/api/v1
ADMIN_V1_PREFIX=/api/admin/v1
BASE_URL=http://test

JWT_SECRET=test-jwt-secret-not-for-production-use
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
PASSWORD_PEPPER=test-pepper-not-for-production-use
ADMIN_SESSION_TTL_HOURS=12

# Test DB lives at port 3307 to avoid colliding with local dev MySQL on 3306.
# Phase 2 starts using it; Phase 1 tests don't connect.
MYSQL_DSN=mysql+asyncmy://test:test@localhost:3307/pharmacy_test
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=4
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# Redis db 15 reserved for tests (FLUSHDB on suite start).
REDIS_DSN=redis://localhost:6379/15

DEFAULT_LANGUAGE=ru
SUPPORTED_LANGUAGES=ru,ky,en

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

RL_OTP_REQUEST_PER_PHONE_WINDOW_SECONDS=900
RL_OTP_REQUEST_PER_PHONE_MAX=3

SMS_PROVIDER=fake
SMS_SENDER=PharmacyTest

PAYMENT_PROVIDER=fake

CORS_ORIGINS=

IMAGE_STORAGE_DIR=tests/_images
IMAGE_PUBLIC_BASE_URL=/static/images
IMAGE_MAX_BYTES=10485760
