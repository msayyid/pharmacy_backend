# Pharmacy API — example environment file
# Copy to .env for local dev. Do NOT commit .env.
# Reference: BACKEND_BLUEPRINT §5.1 (Settings class).

# ─── App ───────────────────────────────────────────────────────────────────────
ENV=local                                       # local | test | staging | production
DEBUG=true                                      # show /docs, verbose logs
APP_NAME=pharmacy-api
API_V1_PREFIX=/api/v1
ADMIN_V1_PREFIX=/api/admin/v1
BASE_URL=http://localhost:8000

# ─── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-64-byte-random-string-for-local-dev-only
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Static pepper appended to passwords + OTP codes before hashing.
PASSWORD_PEPPER=change-me-to-a-second-random-string-for-local-dev-only
ADMIN_SESSION_TTL_HOURS=12

# ─── Database (MySQL 8.4) ──────────────────────────────────────────────────────
# Format: mysql+asyncmy://USER:PASSWORD@HOST:3306/DBNAME
MYSQL_DSN=mysql+asyncmy://pharmacy:pharmacy@localhost:3306/pharmacy
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# ─── Redis 7 ───────────────────────────────────────────────────────────────────
REDIS_DSN=redis://localhost:6379/0

# ─── i18n ──────────────────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=ru                             # ru | ky | en
SUPPORTED_LANGUAGES=ru,ky,en

# ─── OTP ───────────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ─── Rate limits ───────────────────────────────────────────────────────────────
RL_OTP_REQUEST_PER_PHONE_WINDOW_SECONDS=900
RL_OTP_REQUEST_PER_PHONE_MAX=3

# ─── SMS (PRODUCT §14, BACKEND §10) ────────────────────────────────────────────
# 'fake' writes SMS to log only — use for local dev. 'nikita' is the real KG provider.
SMS_PROVIDER=fake
# SMS_API_URL=https://smspro.nikita.kg/api/...
# SMS_API_KEY=your-nikita-api-key
SMS_SENDER=Pharmacy

# ─── Payments (Phase 1.5+) ─────────────────────────────────────────────────────
PAYMENT_PROVIDER=fake
# PAYMENT_API_URL=https://paybox.money/payment.php
# PAYMENT_MERCHANT_ID=your-merchant-id
# PAYMENT_SECRET=your-secret

# ─── Object storage (R2 / S3-compatible) ───────────────────────────────────────
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_BUCKET=pharmacy-media
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_BASE_URL=https://cdn.pharmacy.kg

# ─── Sentry (optional; absent = no-op) ─────────────────────────────────────────
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Empty = no cross-origin allowed.
CORS_ORIGINS=
